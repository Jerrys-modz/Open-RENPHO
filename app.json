{
  "expo": {
    "name": "Open RENPHO",
    "slug": "open-renpho",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jerrysmodz.openrenpho",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "react-native-ble-plx",
        {
          "bluetoothAlwaysPermission": "Open RENPHO connects to your RENPHO scale and tape measure over Bluetooth to read your measurements."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "scheme": "open-renpho",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1ce902f9-f582-4cd2-a2b7-488ec9bebdf1"
      }
    },
    "owner": "snowdeatroyers-team"
  }
}
