{
  "name": "keel",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@kingstinct/react-native-healthkit": "^16.1.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "^58.0.0",
    "expo-constants": "~58.0.16",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-ble-plx": "^3.5.1",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "build:ios": "eas build --platform ios --profile production",
    "submit:ios": "eas submit --platform ios --profile production --latest",
    "build:testflight": "eas build --platform ios --profile testflight --non-interactive --no-wait",
    "submit:testflight": "eas submit --platform ios --profile testflight --latest --non-interactive",
    "build:device": "eas build --platform ios --profile development"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleDirectories": [
      "node_modules",
      "<rootDir>/node_modules/expo/node_modules"
    ]
  }
}
